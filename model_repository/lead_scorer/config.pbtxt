name: "lead_scorer"
backend: "onnxruntime"
max_batch_size: 64
input [
  { name: "input" data_type: TYPE_FP32 dims: [ 50 ] }
]
output [
  { name: "probabilities" data_type: TYPE_FP32 dims: [ 2 ] }
]
dynamic_batching {
  preferred_batch_size: [ 8, 16, 32 ]
  max_queue_delay_microseconds: 5000
}
instance_group [ { kind: KIND_CPU count: 2 } ]
